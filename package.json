{
  "name": "romix",
  "private": true,
  "version": "0.2.0",
  "description": "Turn YouTube music links into a burned audio CD, with a beautiful native-feeling UI.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "app": "vite --mode electron",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --mode electron",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run",
    "test:live": "node scripts/live-check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "33.2.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-electron": "0.28.8",
    "vitest": "2.1.5"
  }
}

{
  "name": "romix",
  "private": true,
  "version": "0.7.1",
  "author": "DarkerSniper",
  "homepage": "https://github.com/DarkerSniper/Romix",
  "description": "Turn YouTube music links into a burned audio CD, with a beautiful native-feeling UI.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "app": "vite --mode electron",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --mode electron",
    "setup": "node scripts/setup.mjs",
    "test": "vitest run",
    "test:live": "node scripts/live-check.mjs",
    "test:burn": "node scripts/burn-test.mjs",
    "typecheck": "tsc --noEmit",
    "dist": "node scripts/dist.mjs",
    "icon": "electron scripts/make-icon.cjs"
  },
  "build": {
    "appId": "com.darkersniper.romix",
    "productName": "Romix",
    "copyright": "Copyright © 2026 DarkerSniper",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "electron/burner/RomixBurner.cs",
        "to": "burner/RomixBurner.cs"
      }
    ],
    "fileAssociations": [
      {
        "ext": "romix",
        "name": "Romix disc",
        "description": "Romix shared disc",
        "role": "Editor"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Romix-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Romix",
      "artifactName": "Romix-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "framer-motion": "11.11.17",
    "lucide-react": "0.460.0",
    "qrcode-generator": "1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-electron": "0.28.8",
    "vitest": "2.1.5"
  }
}
